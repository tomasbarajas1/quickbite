<!DOCTYPE html>
<html>
    <head>
        <title>Restaurants Listings - QuickBite</title>
        <link rel="stylesheet" href="style.css">
    </head>
    <body>
        <h1>Menu - <%= name %></h1>
        <div>
            <% if(sample.length > 0)    {
                sample.forEach(function(data)   {   %>
                    <h2><%= data.Menu_SubCategory %></h2>
                    <h2><%= data.ItemName %></h2>
                    <h3><%= data.Description %></h3>
                    <h2><b><%= data.Price %></b></h2>
                    <br>
                    <br>
               <% } ) } 
            else { %>
                <h2>No items available</h3>
           <% } %>
        </div>
    </body>
</html>
